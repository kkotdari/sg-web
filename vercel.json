{
  "git": {
    "deploymentEnabled": {
      "feat/**": false,
      "fix/**": false,
      "style/**": false,
      "claude/**": false
    }
  },
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" != \"main\" ]",
  "installCommand": "npm ci --no-audit --no-fund",
  "headers": [
    {
      "source": "/((?!assets/|spr/|pf/|uploader/|sw\\.js).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/uploader/download/(.*)",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment"
        }
      ]
    },
    {
      "source": "/spr/k/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/spr/index.(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/pf/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/pf-feecbae208d9",
      "destination": "/pf/5.1/",
      "permanent": false
    },
    {
      "source": "/pf-feecbae208d9/(.*)",
      "destination": "/pf/5.1/$1",
      "permanent": false
    },
    {
      "source": "/pf/5.1",
      "destination": "/pf/5.1/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
