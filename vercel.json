{
  "git": {
    "deploymentEnabled": {
      "feat/**": false,
      "fix/**": false,
      "style/**": false,
      "claude/**": false
    }
  },
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" != \"main\" ]",
  "installCommand": "npm ci --no-audit --no-fund",
  "headers": [
    {
      "source": "/uploader/download/(.*)",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
